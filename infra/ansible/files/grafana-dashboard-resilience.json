{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "RESILIENCE-ALPHA — Paiement",
  "uid": "resilience-alpha",
  "tags": ["resilience", "paiement"],
  "time": { "from": "now-15m", "to": "now" },
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "title": "Débit des transactions (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(payments_total[30s]))", "legendFormat": "transactions/s", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Latence p95 (s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(payment_latency_seconds_bucket[30s])) by (le))", "legendFormat": "p95", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "title": "Taux d'erreur (err/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(payments_total{status=\"error\"}[30s]))", "legendFormat": "erreurs/s", "refId": "A" }
      ]
    }
  ]
}
